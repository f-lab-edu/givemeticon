#!/usr/bin/env bash
# Git pre-commit hook: when the commit touches coupon-lab/evidence/, every evidence JSON must still parse.
# Install once per clone, from the repository root:
#   git config core.hooksPath coupon-lab/scripts/githooks
# (core.hooksPath replaces .git/hooks for this clone.) Skip once with: git commit --no-verify
set -euo pipefail

staged=$(git diff --cached --name-only)
if grep -q '^coupon-lab/evidence/' <<<"$staged"; then
    if ! "$(cd "$(dirname "$0")" && pwd -P)/../check-evidence.sh"; then
        echo "pre-commit: coupon-lab/evidence/ contains invalid JSON; fix it (evidence is written only by scripts/verify.sh) before committing" >&2
        exit 1
    fi
fi
exit 0
