<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jinddung2.givemeticon.domain.item.mapper.ItemViewMapper">

    <insert id="save">
        INSERT INTO item_view_log(id,
                                  item_id,
                                  user_id,
                                  viewed_at)
        VALUES (#{id},
                #{userId},
                #{itemId},
                NOW())
    </insert>

</mapper>
