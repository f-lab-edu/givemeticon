<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jinddung2.givemeticon.domain.category.mapper.CategoryMapper">

    <resultMap id="categoryResultMap" type="Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="findById" parameterType="int" resultType="Category">
        SELECT id, name
        FROM category
        where id = #{id}
    </select>

    <select id="findAll" resultType="Category" resultMap="categoryResultMap">
        SELECT id, name
        FROM category
    </select>

    <update id="updateName">
        UPDATE category
        SET name = #{newName}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE
        FROM category
        WHERE id = #{id}
    </delete>
</mapper>
